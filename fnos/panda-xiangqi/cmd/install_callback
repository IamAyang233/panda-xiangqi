#!/bin/bash
# 熊猫象棋生命周期钩子：安装/升级后补回 fnpack 丢失的可执行位。
#
# fnpack 打包把所有文件写成 0666（无可执行位），补位必须在 root 上下文完成
# —— 应用以专用用户（config/privilege → panda_xiangqi）运行，进程内 chmod
# 会因文件属主是 root 而 EPERM。
#
# 只需补主程序：引擎已改为 Go 内嵌，权重是纯数据文件（不参与 exec），
# 不需要可执行位。
if [ -n "${TRIM_APPDEST:-}" ] && [ -d "${TRIM_APPDEST}/server" ]; then
  chmod 0755 "${TRIM_APPDEST}/server/panda-xiangqi" 2>/dev/null || true
fi
exit 0
