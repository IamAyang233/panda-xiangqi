appname=panda-xiangqi
version=2.0.8
display_name=熊猫象棋
desc=熊猫象棋 —— 国风中国象棋工具。<br>- 本地引擎 16 档棋力人机对战<br>- 大模型 AI 对弈，附带棋谱讲解，兼容 OpenAI 接口<br>- 双人同屏，棋盘翻转，亲友线下对弈<br>- 经典残局挑战，星级评分练杀招<br>- 小马冲冲：无尽闯关玩法，步步接战，沉浸式快节奏象棋对局<br>古朴国风界面，下棋练棋一步到位。
source=thirdparty
platform=x86
maintainer=PanDa
maintainer_url=https://www.aykeji.cn
distributor=PanDa

# 统一网关（Socket 转发）需要较新的 fnOS；如你的设备版本更低且网关可用，可下调此值。
os_min_version=1.1.3100

desktop_uidir=ui
desktop_applaunchname=panda-xiangqi.main

# Socket 模式：应用监听 Unix Socket，由网关转发，无需固定端口、无需 root。
ctl_stop=true
checkport=false

changelog=2.0.8：1.优化不同大模型的兼容性问题<br>2.新增自定义残局功能<br>3.优化手机端 UI<br>4.全面使用自研象棋引擎（修复部分用户皮卡鱼引擎无法调用）<br>5.新增棋谱功能（可在对局结束保存对局用于复盘）
