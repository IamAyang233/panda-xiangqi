appname=panda-xiangqi
version=1.1.3
display_name=熊猫象棋
desc=熊猫象棋（PanDa Xiangqi）是一款中国象棋对战平台：集成皮卡鱼（Pikafish）UCI 引擎（fnOS 版 x86 / arm 随包内置、零外部依赖）、大模型对弈、双人对弈与残局闯关。
source=thirdparty
platform=x86
maintainer=PanDa
maintainer_url=https://www.aykeji.cn
distributor=PanDa

# 统一网关（Socket 转发）需要较新的 fnOS；如你的设备版本更低且网关可用，可下调此值。
os_min_version=1.1.3100

desktop_uidir=ui
desktop_applaunchname=panda-xiangqi.main

# Socket 模式：应用监听 Unix Socket，由网关转发，无需固定端口、无需 root。
ctl_stop=true
checkport=false

changelog=1.1.3：移除大厅底部「引擎：pikafish · 已内置可用」状态提示。1.1.2：修复皮卡鱼引擎因 fnpack 打包剥离可执行位而启动失败的问题——已在拉起引擎前（Start 之前）补回 +x 权限，确保随包内置的皮卡鱼真正可被调用。1.1.1：修复 1.1.0 仅声明未实际内置皮卡鱼的问题——fnOS 版（x86 / arm）现已随包内置皮卡鱼引擎与 NNUE 权重，开箱即用；低档位与引擎缺失时自动回退自研引擎。1.1.0：飞牛 fnOS 统一网关原生应用（免 root、专用用户运行）；内置推送更新检测与反馈入口；单二进制内嵌前端与全部残局，零外部依赖。
